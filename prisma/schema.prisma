generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INTERNAL
  CLIENT
}

enum TriggerType {
  BRIEFING
  KICKOFF
  CONDICOES_INICIO
  MARCO_CICLO
  MANUAL
  CLICKUP_ONLY
}

enum DayType {
  UTEIS
  CORRIDOS
}

enum DeliverableKind {
  BAR
  MILESTONE
}

enum PanelNoteStatus {
  CONCLUIDO
  EM_DIA
  ATRASO_OPERACIONAL
  ATRASO_CONTRATUAL
  A_FAZER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(INTERNAL)
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
}

model Client {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logoUrl   String?
  createdAt DateTime  @default(now())
  projects  Project[]
  users     User[]
}

model Project {
  id                 String    @id @default(cuid())
  clientId           String
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name               String
  slug               String    @unique
  briefingDate       DateTime
  cutoffDate         DateTime?
  clickupWorkspaceId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  fronts             Front[]
  snapshots          ReportSnapshot[]
  panelNotes         PanelNote[]
}

model Front {
  id                  String        @id @default(cuid())
  projectId           String
  project             Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                String
  vendorName          String
  colorHex            String        @default("#2563eb")
  order               Int           @default(0)
  clickupListId       String?
  contractFileUrl     String?
  contractFileName    String?
  contractUploadedAt  DateTime?
  /// Sugestões de regras de prazo extraídas do contrato pela IA (revisadas antes de virar Deliverable).
  contractAnalysis    Json?
  contractAnalyzedAt  DateTime?
  deliverables        Deliverable[]
}

model Deliverable {
  id                String          @id @default(cuid())
  frontId           String
  front             Front           @relation(fields: [frontId], references: [id], onDelete: Cascade)
  name              String
  ruleLabel         String?
  kind              DeliverableKind @default(BAR)
  triggerType       TriggerType     @default(MANUAL)
  triggerDate       DateTime?
  slaDays           Int?
  slaDayType        DayType         @default(UTEIS)
  isEstimated       Boolean         @default(false)
  startDateOverride DateTime?
  endDateOverride   DateTime?
  clickupTaskId     String?
  manualStatusLabel String?
  hasApprovalWindow Boolean         @default(false)
  approvalDays      Int             @default(5)
  approvalStartOverride DateTime?
  approvalEndOverride   DateTime?
  approvalColorHex  String?
  order             Int             @default(0)
  colorHexOverride  String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

/// Linha extra e livre no painel executivo de um projeto (notas/KPIs que não vêm do ClickUp/SLA).
model PanelNote {
  id         String          @id @default(cuid())
  projectId  String
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label      String
  ruleText   String?
  dateText   String?
  statusText String?
  status     PanelNoteStatus @default(EM_DIA)
  order      Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model ReportSnapshot {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cutoffDate  DateTime
  generatedAt DateTime @default(now())
  data        Json
}

/// Chave-valor simples para configurações globais (ex: token da API do ClickUp).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ClickupTaskCache {
  taskId       String   @id
  name         String
  status       String
  dueDate      DateTime?
  url          String
  lastSyncedAt DateTime @default(now())
}
